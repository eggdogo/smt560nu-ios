# gtel.rc - boot script for gtel_shell (installed at /gtel.rc on the ramdisk)
# One command per line, same commands as the interactive prompt ('help' lists them).
# Everything printed also lands in the kernel's RAM log: after the run, hold
# power to reset into lk2nd and run `python tools/pull_log.py` to get it all.

# Timer debugging: every spawn prints a TIMER line with the live
# CNTV/GIC-400 state (patch_timer_diag.py). Compare before/after a busy-wait.
echo === timer diag: spawn 1 ===
spawn /usr/sbin/syslogd
spin 500
echo === timer diag: spawn 2 (after spin) ===
spawn /usr/libexec/xpcproxy
spin 500
echo === timer diag: spawn 3 ===
spawn /usr/libexec/xpcproxy

echo === now sleep 2 (hangs if the timer never fires) ===
sleep 2
echo === sleep returned! timer works ===
spawn /usr/libexec/xpcproxy
echo === script done, safe to reset into lk2nd ===
