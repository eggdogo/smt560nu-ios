 static void
 sweet_revert_dyld_bind_at_load(void)
 {
@@ -1567,6 +1645,7 @@ bsdinit_task(void)
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 	sweet_inject_gestalt_cache();
 	sweet_revert_dyld_bind_at_load();
+	gtel_appoint_backboardd();
 #endif
 
 	load_init_program(p);
