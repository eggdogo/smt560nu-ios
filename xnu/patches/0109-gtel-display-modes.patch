 };
 
+/*
+ * Manually appoint backboardd main display driver by patching 0x1e920
+ * from 0xaa0003e2 (mov x2, x0) to 0x52800022 (mov w2, #1) so that
+ * [server displayWithDisplayId:1] is called directly.
+ */
+#define GTEL_BACKBOARDD_PATH "/usr/libexec/backboardd"
+#define GTEL_BACKBOARDD_OFF  0x1e920
+
+static void
+gtel_appoint_backboardd(void)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	mount_t mp = rootvnode ? rootvnode->v_mount : NULL;
+	uint64_t saved_flags = 0;
+	uint32_t cur = 0;
+	uint32_t patched = 0x52800022; /* mov w2, #1 */
+	int resid = 0;
+	int error = 0;
+	int err = 0;
+
+	error = vnode_open(GTEL_BACKBOARDD_PATH, FREAD, 0, 0, &vp, ctx);
+	if (error != 0) {
+		printf("SWEET: cannot open %s (errno %d)\n", GTEL_BACKBOARDD_PATH, error);
+		return;
+	}
+
+	err = vn_rdwr(UIO_READ, vp, (caddr_t)&cur, 4,
+	    GTEL_BACKBOARDD_OFF, UIO_SYSSPACE, IO_NODELOCKED,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	vnode_close(vp, FREAD, ctx);
+	if (err != 0 || resid != 0) {
+		printf("SWEET: cannot read %s (errno %d)\n", GTEL_BACKBOARDD_PATH, err);
+		return;
+	}
+
+	if (cur == patched) {
+		printf("SWEET: backboardd display driver already appointed\n");
+		return;
+	}
+	if (cur != 0xaa0003e2) {
+		printf("SWEET: backboardd at 0x%x has unexpected opcode 0x%08x\n",
+		    GTEL_BACKBOARDD_OFF, cur);
+		return;
+	}
+
+	if (mp && (mp->mnt_flag & MNT_RDONLY)) {
+		saved_flags = mp->mnt_flag;
+		mp->mnt_flag &= ~MNT_RDONLY;
+	}
+
+	vp = NULLVP;
+	error = vnode_open(GTEL_BACKBOARDD_PATH, (FREAD | FWRITE), 0, 0, &vp, ctx);
+	if (error != 0) {
+		printf("SWEET: cannot open %s for write (errno %d)\n", GTEL_BACKBOARDD_PATH, error);
+		goto out;
+	}
+
+	resid = 0;
+	err = vn_rdwr(UIO_WRITE, vp, (caddr_t)&patched, 4,
+	    GTEL_BACKBOARDD_OFF, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	(void)VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	vnode_close(vp, FWRITE, ctx);
+
+	if (err == 0 && resid == 0) {
+		printf("SWEET: backboardd display driver appointed (mov w2, #1 at 0x%x)\n",
+		    GTEL_BACKBOARDD_OFF);
+	} else {
+		printf("SWEET: backboardd display appointment failed (errno %d)\n", err);
+	}
+
+out:
+	if (mp && saved_flags) {
+		mp->mnt_flag = saved_flags;
+	}
+}
