 static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
 static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
@@ -298,8 +300,7 @@ ufs_write_blocks(uint64_t lba, uint32_t count)
 		return EPERM;
 	}
 	if (su.mmc) {
-		printf("SWEET UFS: eMMC writes are not implemented yet\n");
-		return EPERM;
+		return gtel_mmc_write(lba * MMC_PER_BLOCK, count * MMC_PER_BLOCK, (const void *)(su.dma + DMA_BOUNCE));
 	}
 	uint8_t cdb[10] = {
 		0x2a, 0,
@@ -907,6 +908,67 @@ sweet_log_start(void)
  */
 int sweet_ufs_attach_mmc(void);
 
+/*
+ * ufsrw=1: open the partition for writing, after proving the write path
+ * on its LAST block (past the end of the 10 GB HFS image, never used):
+ * save it, write a pattern, read it back, restore the original.
+ * Called with sweet_ufs_lock held, after ufs_find_partition.
+ */
+static int
+mmc_write_selftest(void)
+{
+	uint64_t lo = su.first_block * MMC_PER_BLOCK;
+	uint64_t hi = (su.first_block + su.nblocks) * MMC_PER_BLOCK;
+	uint64_t last = su.first_block + su.nblocks - 1;
+	uint8_t *b = (uint8_t *)(su.dma + DMA_BOUNCE);
+	uint8_t *save = kalloc_data(UFS_BLOCK, Z_WAITOK);
+	int error;
+
+	if (!save) {
+		return ENOMEM;
+	}
+	gtel_mmc_set_write_window(lo, hi);
+	su.writable = true;
+	if ((error = ufs_read_blocks(last, 1))) {
+		goto fail;
+	}
+	memcpy(save, b, UFS_BLOCK);
+	for (uint32_t i = 0; i < UFS_BLOCK; i++) {
+		b[i] = (uint8_t)(i * 7 + 0x5a);
+	}
+	if ((error = ufs_write_blocks(last, 1))) {
+		goto fail;
+	}
+	memset(b, 0, UFS_BLOCK);
+	if ((error = ufs_read_blocks(last, 1))) {
+		goto fail;
+	}
+	for (uint32_t i = 0; i < UFS_BLOCK; i++) {
+		if (b[i] != (uint8_t)(i * 7 + 0x5a)) {
+			printf("SWEET UFS: write self-test MISMATCH at byte %u: 0x%02x\n", i, b[i]);
+			error = EIO;
+			break;
+		}
+	}
+	memcpy(b, save, UFS_BLOCK);
+	int e2 = ufs_write_blocks(last, 1);
+	if (!error) {
+		error = e2;
+	}
+	if (error) {
+		goto fail;
+	}
+	kfree_data(save, UFS_BLOCK);
+	printf("SWEET UFS: eMMC write self-test ok (block 0x%llx)\n", last);
+	return 0;
+fail:
+	printf("SWEET UFS: eMMC write self-test FAILED (%d), staying read-only\n", error);
+	su.writable = false;
+	gtel_mmc_set_write_window(0, 0);
+	kfree_data(save, UFS_BLOCK);
+	return 0;
+}
+
 int
 sweet_ufs_attach_mmc(void)
 {
@@ -925,6 +987,8 @@ sweet_ufs_attach_mmc(void)
 	su.mmc = true;
 	su.secsize = DEV_BSIZE;
 	su.writable = false;
+	int rw = 0;
+	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
 
 	lck_mtx_lock(&sweet_ufs_lock);
 	error = ufs_find_partition(want);
@@ -932,6 +996,9 @@ sweet_ufs_attach_mmc(void)
 		/* Self test: the first block, as a filesystem would see it */
 		error = ufs_read_blocks(su.first_block, 1);
 	}
+	if (!error && rw) {
+		error = mmc_write_selftest();
+	}
 	lck_mtx_unlock(&sweet_ufs_lock);
 	if (error) {
 		printf("SWEET UFS: eMMC partition \"%s\" unavailable (%d)\n", want, error);
@@ -961,8 +1028,8 @@ sweet_ufs_attach_mmc(void)
 	printf("SWEET ufs: root aliased as disk0s1\n");
 #endif
 	su.ready = true;
-	printf("SWEET UFS: \"%s\" on eMMC: first block 0x%llx, %llu MiB, read-only\n",
-	    want, su.first_block, su.nblocks * UFS_BLOCK >> 20);
+	printf("SWEET UFS: \"%s\" on eMMC: first block 0x%llx, %llu MiB, %s\n",
+	    want, su.first_block, su.nblocks * UFS_BLOCK >> 20, su.writable ? "read-write" : "read-only");
 	return 0;
 }
 
