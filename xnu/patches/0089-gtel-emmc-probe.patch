+/*
+ * gtel eMMC probe: MSM8916 SDHCI1 (SM-T560NU internal eMMC), read-only.
+ *
+ * First step towards an eMMC root. lk2nd initialised the card, then (CAF
+ * LK target_uninit) put it to sleep and switched the controller back to
+ * legacy MCI mode before jumping to us. This re-enables SDHCI mode, wakes
+ * and selects the card, and reads the GPT with polled PIO single-block
+ * reads (no DMA, no interrupts), logging every step so a failure can be
+ * read back with tools/pull_log.py. Runs in its own thread so a stuck
+ * card never holds up launchd. Disabled with boot-arg gtelmmc=0.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+
+/* msm8916.dtsi sdhc_1: hc_mem 0x07824900, core_mem 0x07824000 */
+#define SDHC1_HC_PA             0x07824900
+#define SDHC1_CORE_PA           0x07824000
+
+#define CORE_HC_MODE            0x78
+/* Power IRQ handshake (sdhci-msm v1 core registers) */
+#define CORE_PWRCTL_STATUS      0xdc
+#define CORE_PWRCTL_MASK        0xe0
+#define CORE_PWRCTL_CLEAR       0xe4
+#define CORE_PWRCTL_CTL         0xe8
+#define  PWRCTL_BUS_OFF         (1u << 0)
+#define  PWRCTL_BUS_ON          (1u << 1)
+#define  PWRCTL_IO_LOW          (1u << 2)
+#define  PWRCTL_IO_HIGH         (1u << 3)
+#define  PWRCTL_BUS_SUCCESS     (1u << 0)
+#define  PWRCTL_IO_SUCCESS      (1u << 2)
+#define  HC_MODE_EN             (1u << 0)
+#define  FF_CLK_SW_RST_DIS      (1u << 13)
+
+/* Standard SDHCI registers */
+#define SDHCI_BLOCK_SIZE        0x04
+#define SDHCI_BLOCK_COUNT       0x06
+#define SDHCI_ARGUMENT          0x08
+#define SDHCI_TRANSFER_MODE     0x0c
+#define  XFER_READ              (1u << 4)
+#define SDHCI_COMMAND           0x0e
+#define  CMD_RESP_NONE          0x00
+#define  CMD_RESP_48            0x02
+#define  CMD_RESP_48_BUSY       0x03
+#define  CMD_CRC                (1u << 3)
+#define  CMD_INDEX              (1u << 4)
+#define  CMD_DATA               (1u << 5)
+#define SDHCI_RESPONSE          0x10
+#define SDHCI_BUFFER            0x20
+#define SDHCI_PRESENT_STATE     0x24
+#define  PRES_CMD_INHIBIT       (1u << 0)
+#define  PRES_DAT_INHIBIT       (1u << 1)
+#define SDHCI_HOST_CONTROL      0x28
+#define SDHCI_POWER_CONTROL     0x29
+#define SDHCI_CLOCK_CONTROL     0x2c
+#define  CLK_INT_EN             (1u << 0)
+#define  CLK_INT_STABLE         (1u << 1)
+#define  CLK_SD_EN              (1u << 2)
+#define SDHCI_SOFTWARE_RESET    0x2f
+#define  RESET_CMD              (1u << 1)
+#define  RESET_DATA             (1u << 2)
+#define SDHCI_INT_STATUS        0x30    /* normal (low 16) | error (high 16) */
+#define  INT_CMD_DONE           (1u << 0)
+#define  INT_XFER_DONE          (1u << 1)
+#define  INT_BUF_RD_READY       (1u << 5)
+#define  INT_ERROR              (1u << 15)
+#define SDHCI_INT_ENABLE        0x34
+#define SDHCI_SIGNAL_ENABLE     0x38
+#define SDHCI_CAPABILITIES      0x40
+#define SDHCI_HOST_CONTROL2     0x3e
+#define SDHCI_HOST_VERSION      0xfe
+
+#define CMD_RESP_136            0x01
+#define MMC_OCR_REQ             0x40ff8080u     /* sector mode, 1.7-3.6 V */
+#define MMC_RCA                 2u
+#define BASE_CLK_KHZ            200000u         /* CAPS base clock field */
+
+#define MMC_BLOCK               512u
+#define GPT_MAX_ENTRIES         128u
+
+static vm_offset_t hc, core;
+static uint32_t card_rca;
+
+static inline uint32_t rd32(vm_offset_t b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline uint16_t rd16(vm_offset_t b, uint32_t o) { return *(volatile uint16_t *)(b + o); }
+static inline uint8_t rd8(vm_offset_t b, uint32_t o) { return *(volatile uint8_t *)(b + o); }
+static inline void wr32(vm_offset_t b, uint32_t o, uint32_t v) { *(volatile uint32_t *)(b + o) = v; }
+static inline void wr16(vm_offset_t b, uint32_t o, uint16_t v) { *(volatile uint16_t *)(b + o) = v; }
+static inline void wr8(vm_offset_t b, uint32_t o, uint8_t v) { *(volatile uint8_t *)(b + o) = v; }
+
+static void dump_regs(const char *when);
+
+/* Poll until (reg & mask) == want, 10 us steps; false on timeout */
+static bool
+wait32(uint32_t off, uint32_t mask, uint32_t want, uint32_t timeout_ms)
+{
+	for (uint32_t i = 0; i < timeout_ms * 100; i++) {
+		if ((rd32(hc, off) & mask) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+static void
+sdhci_reset_lines(void)
+{
+	wr8(hc, SDHCI_SOFTWARE_RESET, (uint8_t)(RESET_CMD | RESET_DATA));
+	for (int i = 0; i < 10000 && (rd8(hc, SDHCI_SOFTWARE_RESET) & (RESET_CMD | RESET_DATA)); i++) {
+		delay(10);
+	}
+}
+
+static void
+dump_regs(const char *when)
+{
+	printf("gtel mmc: %s: HC_MODE=0x%x PRES=0x%08x HOSTCTL=0x%02x PWR=0x%02x CLK=0x%04x CAPS=0x%08x VER=0x%04x INT=0x%08x INTEN=0x%08x PWRCTL=0x%x/0x%x\n",
+	    when, rd32(core, CORE_HC_MODE), rd32(hc, SDHCI_PRESENT_STATE), rd8(hc, SDHCI_HOST_CONTROL),
+	    rd8(hc, SDHCI_POWER_CONTROL), rd16(hc, SDHCI_CLOCK_CONTROL), rd32(hc, SDHCI_CAPABILITIES),
+	    rd16(hc, SDHCI_HOST_VERSION), rd32(hc, SDHCI_INT_STATUS), rd32(hc, SDHCI_INT_ENABLE),
+	    rd32(core, CORE_PWRCTL_STATUS), rd32(core, CORE_PWRCTL_MASK));
+}
+
+/*
+ * Qualcomm hosts stall every bus power or I/O voltage change until software
+ * acknowledges it through the PWRCTL registers (sdhci_msm_handle_pwr_irq in
+ * Linux). Without interrupts, poll for the request and ack it.
+ */
+static void
+msm_pwr_ack(const char *why, uint32_t wait_ms)
+{
+	uint32_t st = 0;
+	for (uint32_t i = 0; i <= wait_ms * 100; i++) {
+		if ((st = rd32(core, CORE_PWRCTL_STATUS) & 0xf)) {
+			break;
+		}
+		delay(10);
+	}
+	if (!st) {
+		printf("gtel mmc: %s: no power request pending\n", why);
+		return;
+	}
+	wr32(core, CORE_PWRCTL_CLEAR, st);
+	uint32_t ack = 0;
+	if (st & (PWRCTL_BUS_ON | PWRCTL_BUS_OFF)) {
+		ack |= PWRCTL_BUS_SUCCESS;
+	}
+	if (st & (PWRCTL_IO_LOW | PWRCTL_IO_HIGH)) {
+		ack |= PWRCTL_IO_SUCCESS;
+	}
+	wr32(core, CORE_PWRCTL_CTL, ack);
+	printf("gtel mmc: %s: acked power request 0x%x\n", why, st);
+}
+
+/*
+ * Issue one command; flags is the low byte of the SDHCI command register.
+ * Returns 0 and the R1/R1b response, or an error with the status logged.
+ */
+static int
+mmc_cmd(uint8_t idx, uint32_t arg, uint8_t flags, uint32_t *resp)
+{
+	uint32_t inhibit = PRES_CMD_INHIBIT | ((flags & CMD_DATA) || (flags & 3) == CMD_RESP_48_BUSY ? PRES_DAT_INHIBIT : 0);
+	if (!wait32(SDHCI_PRESENT_STATE, inhibit, 0, 100)) {
+		printf("gtel mmc: CMD%u: controller busy, PRES=0x%08x\n", idx, rd32(hc, SDHCI_PRESENT_STATE));
+		sdhci_reset_lines();
+		return EBUSY;
+	}
+	wr32(hc, SDHCI_INT_STATUS, 0xffffffff);
+	wr32(hc, SDHCI_ARGUMENT, arg);
+	wr16(hc, SDHCI_COMMAND, (uint16_t)((idx << 8) | flags));
+	/*
+	 * For R1b this host may report only transfer-complete (end of busy)
+	 * and never command-complete, so either one finishes the command.
+	 */
+	uint32_t done = INT_CMD_DONE | ((flags & 3) == CMD_RESP_48_BUSY ? INT_XFER_DONE : 0);
+	for (uint32_t i = 0; i < 100000 && !(rd32(hc, SDHCI_INT_STATUS) & (done | INT_ERROR)); i++) {
+		delay(10);
+	}
+	uint32_t st = rd32(hc, SDHCI_INT_STATUS);
+	if (!(st & done) || (st & INT_ERROR)) {
+		printf("gtel mmc: CMD%u arg 0x%x failed: INT=0x%08x\n", idx, arg, rd32(hc, SDHCI_INT_STATUS));
+		dump_regs("after failed command");
+		sdhci_reset_lines();
+		return EIO;
+	}
+	if (resp) {
+		*resp = rd32(hc, SDHCI_RESPONSE);
+	}
+	wr32(hc, SDHCI_INT_STATUS, INT_CMD_DONE | INT_XFER_DONE);
+	/* R1b: the card holds DAT0 low while busy */
+	if ((flags & 3) == CMD_RESP_48_BUSY) {
+		if (!wait32(SDHCI_PRESENT_STATE, PRES_DAT_INHIBIT, 0, 1000)) {
+			printf("gtel mmc: CMD%u: card stayed busy\n", idx);
+			return ETIMEDOUT;
+		}
+		/* This host can leave its command state machine half-finished after R1b */
+		sdhci_reset_lines();
+	}
+	return 0;
+}
+
+static const char *const mmc_states[] = {
+	"idle", "ready", "ident", "stby", "tran", "data", "rcv", "prg", "dis", "btst", "slp",
+};
+
+static int
+mmc_status(uint32_t rca, uint32_t *state)
+{
+	uint32_t r;
+	int error = mmc_cmd(13, rca << 16, CMD_RESP_48 | CMD_CRC | CMD_INDEX, &r);
+	if (!error) {
+		*state = (r >> 9) & 0xf;
+	}
+	return error;
+}
+
+/* SD clock = base / (2 * div), div 0 = base; SDHCI v3 10-bit divider */
+static void
+sdhci_set_clock_khz(uint32_t khz)
+{
+	uint32_t div = (BASE_CLK_KHZ + 2 * khz - 1) / (2 * khz);
+	if (div > 0x3ff) {
+		div = 0x3ff;
+	}
+	uint16_t clk = rd16(hc, SDHCI_CLOCK_CONTROL);
+	wr16(hc, SDHCI_CLOCK_CONTROL, (uint16_t)(clk & ~CLK_SD_EN));
+	clk = (uint16_t)(((div & 0xff) << 8) | ((div >> 8) << 6) | CLK_INT_EN);
+	wr16(hc, SDHCI_CLOCK_CONTROL, clk);
+	for (int i = 0; i < 2000 && !(rd16(hc, SDHCI_CLOCK_CONTROL) & CLK_INT_STABLE); i++) {
+		delay(10);
+	}
+	wr16(hc, SDHCI_CLOCK_CONTROL, (uint16_t)(clk | CLK_SD_EN));
+	delay(1000);
+	printf("gtel mmc: clock %u kHz (div %u), CLK=0x%04x\n", BASE_CLK_KHZ / (2 * div), div,
+	    rd16(hc, SDHCI_CLOCK_CONTROL));
+}
+
+/*
+ * eMMC power-on identification (JEDEC 84 6.4): works whatever state lk2nd
+ * left the card in, including sleep, since CMD0 is accepted there. 1-bit
+ * bus, legacy timing, 400 kHz, then 25 MHz once selected.
+ */
+static int
+mmc_identify(void)
+{
+	uint32_t r = 0, state = 0;
+	int error;
+
+	wr8(hc, SDHCI_HOST_CONTROL, (uint8_t)(rd8(hc, SDHCI_HOST_CONTROL) & ~0x26u));   /* 1-bit, no HS */
+	wr16(hc, SDHCI_HOST_CONTROL2, (uint16_t)(rd16(hc, SDHCI_HOST_CONTROL2) & ~0x7u)); /* no UHS mode */
+	sdhci_set_clock_khz(400);
+
+	(void)mmc_cmd(0, 0, CMD_RESP_NONE, NULL);
+	delay(1000);
+
+	for (int i = 0; i < 1000; i++) {
+		if ((error = mmc_cmd(1, MMC_OCR_REQ, CMD_RESP_48, &r))) {
+			return error;
+		}
+		if (r & 0x80000000u) {
+			break;
+		}
+		delay(1000);
+	}
+	printf("gtel mmc: CMD1 OCR 0x%08x (%s)\n", r, (r & 0x80000000u) ? "ready" : "still busy");
+	if (!(r & 0x80000000u)) {
+		return ETIMEDOUT;
+	}
+	if ((error = mmc_cmd(2, 0, CMD_RESP_136 | CMD_CRC, NULL))) {
+		return error;
+	}
+	printf("gtel mmc: CID %08x %08x %08x %08x\n", rd32(hc, SDHCI_RESPONSE + 12),
+	    rd32(hc, SDHCI_RESPONSE + 8), rd32(hc, SDHCI_RESPONSE + 4), rd32(hc, SDHCI_RESPONSE));
+	if ((error = mmc_cmd(3, MMC_RCA << 16, CMD_RESP_48 | CMD_CRC | CMD_INDEX, &r))) {
+		return error;
+	}
+	card_rca = MMC_RCA;
+	if ((error = mmc_cmd(7, card_rca << 16, CMD_RESP_48_BUSY | CMD_CRC | CMD_INDEX, &r))) {
+		return error;
+	}
+	sdhci_set_clock_khz(25000);
+	if ((error = mmc_status(card_rca, &state))) {
+		return error;
+	}
+	printf("gtel mmc: identified, RCA %u, state %s\n", card_rca, state < 11 ? mmc_states[state] : "?");
+	return state == 4 ? 0 : EIO;
+}
+
+/* Bring the card lk2nd left behind to the transfer state */
+static int
+mmc_wake(void)
+{
+	uint32_t state = 0, r;
+	int error = ENODEV;
+
+	/* CAF LK uses RCA 2 for eMMC; try the others in case lk2nd differs */
+	static const uint32_t rcas[] = { 2 };
+	for (unsigned i = 0; i < sizeof(rcas) / sizeof(rcas[0]); i++) {
+		if (!(error = mmc_status(rcas[i], &state))) {
+			card_rca = rcas[i];
+			break;
+		}
+	}
+	if (error) {
+		return error;
+	}
+	printf("gtel mmc: RCA %u, state %s\n", card_rca, state < 11 ? mmc_states[state] : "?");
+
+	if (state == 10) {              /* slp -> stby */
+		if ((error = mmc_cmd(5, card_rca << 16, CMD_RESP_48_BUSY, &r))) {
+			return error;
+		}
+		(void)mmc_status(card_rca, &state);
+		printf("gtel mmc: after CMD5 awake: %s\n", state < 11 ? mmc_states[state] : "?");
+	}
+	if (state == 3) {               /* stby -> tran */
+		if ((error = mmc_cmd(7, card_rca << 16, CMD_RESP_48_BUSY | CMD_CRC | CMD_INDEX, &r))) {
+			return error;
+		}
+		(void)mmc_status(card_rca, &state);
+		printf("gtel mmc: after CMD7 select: %s\n", state < 11 ? mmc_states[state] : "?");
+	}
+	return state == 4 ? 0 : EIO;
+}
+
+/* One 512-byte block, polled PIO */
+static int
+mmc_read_block(uint64_t lba, uint32_t *buf)
+{
+	if (!wait32(SDHCI_PRESENT_STATE, PRES_CMD_INHIBIT | PRES_DAT_INHIBIT, 0, 100)) {
+		sdhci_reset_lines();
+	}
+	wr32(hc, SDHCI_INT_STATUS, 0xffffffff);
+	wr16(hc, SDHCI_BLOCK_SIZE, (uint16_t)MMC_BLOCK);
+	wr16(hc, SDHCI_BLOCK_COUNT, 1);
+	wr32(hc, SDHCI_ARGUMENT, (uint32_t)lba);        /* sector addressing (>2 GiB card) */
+	wr16(hc, SDHCI_TRANSFER_MODE, (uint16_t)XFER_READ);
+	wr16(hc, SDHCI_COMMAND, (uint16_t)((17 << 8) | CMD_DATA | CMD_CRC | CMD_INDEX | CMD_RESP_48));
+
+	if (!wait32(SDHCI_INT_STATUS, INT_BUF_RD_READY | INT_ERROR, INT_BUF_RD_READY, 1000) &&
+	    !(rd32(hc, SDHCI_INT_STATUS) & INT_BUF_RD_READY)) {
+		printf("gtel mmc: read LBA %llu failed: INT=0x%08x PRES=0x%08x\n", lba,
+		    rd32(hc, SDHCI_INT_STATUS), rd32(hc, SDHCI_PRESENT_STATE));
+		sdhci_reset_lines();
+		return EIO;
+	}
+	wr32(hc, SDHCI_INT_STATUS, INT_BUF_RD_READY);
+	for (unsigned i = 0; i < MMC_BLOCK / 4; i++) {
+		buf[i] = rd32(hc, SDHCI_BUFFER);
+	}
+	if (!wait32(SDHCI_INT_STATUS, INT_XFER_DONE, INT_XFER_DONE, 1000)) {
+		printf("gtel mmc: no transfer-complete for LBA %llu: INT=0x%08x\n", lba, rd32(hc, SDHCI_INT_STATUS));
+	}
+	wr32(hc, SDHCI_INT_STATUS, 0xffffffff);
+	return 0;
+}
+
+static void
+mmc_print_gpt(void)
+{
+	static uint32_t blk[MMC_BLOCK / 4];
+	const uint8_t *b = (const uint8_t *)blk;
+
+	if (mmc_read_block(1, blk)) {
+		return;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("gtel mmc: LBA 1 is not a GPT header: %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]);
+		return;
+	}
+	uint64_t entry_lba, last_usable;
+	uint32_t nent, esz;
+	memcpy(&last_usable, b + 48, 8);
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	printf("gtel mmc: GPT: %u entries of %u bytes at LBA %llu, disk %llu MiB\n",
+	    nent, esz, entry_lba, (last_usable + 1) * MMC_BLOCK >> 20);
+	if (esz != 128 || nent > GPT_MAX_ENTRIES) {
+		return;
+	}
+
+	unsigned shown = 0;
+	for (uint32_t i = 0; i < nent; i++) {
+		if (i % (MMC_BLOCK / 128) == 0 && mmc_read_block(entry_lba + i / (MMC_BLOCK / 128), blk)) {
+			return;
+		}
+		const uint8_t *e = b + (i % (MMC_BLOCK / 128)) * 128;
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (first == 0 && last == 0) {
+			continue;
+		}
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		printf("gtel mmc:  %2u %-16s LBA %8llu-%8llu  %6llu MiB\n", i + 1, name, first, last,
+		    (last - first + 1) * MMC_BLOCK >> 20);
+		shown++;
+	}
+	printf("gtel mmc: %u partitions\n", shown);
+}
+
+static void
+gtel_mmc_probe_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	/* Both register blocks share one 4 KiB page; hc_mem is not page aligned */
+	core = ml_io_map(SDHC1_CORE_PA, 0x1000);
+	hc = core + (SDHC1_HC_PA - SDHC1_CORE_PA);
+	dump_regs("as lk2nd left it");
+
+	uint32_t mode = rd32(core, CORE_HC_MODE);
+	uint8_t pwr = rd8(hc, SDHCI_POWER_CONTROL);
+	if (!(mode & HC_MODE_EN)) {
+		wr32(core, CORE_HC_MODE, mode | HC_MODE_EN | FF_CLK_SW_RST_DIS);
+		delay(100);
+	}
+	msm_pwr_ack("mode switch", 10);
+	sdhci_reset_lines();
+	msm_pwr_ack("line reset", 10);
+
+	/* The mode switch drops bus power; restore what lk2nd had (1.8 V, on) */
+	if (!(rd8(hc, SDHCI_POWER_CONTROL) & 1)) {
+		if (!(pwr & 1)) {
+			pwr = 0x0b;
+		}
+		wr8(hc, SDHCI_POWER_CONTROL, (uint8_t)(pwr & ~1u));
+		msm_pwr_ack("voltage select", 100);
+		wr8(hc, SDHCI_POWER_CONTROL, pwr);
+		msm_pwr_ack("bus power on", 100);
+		delay(1000);
+	}
+
+	uint16_t clk = rd16(hc, SDHCI_CLOCK_CONTROL);
+	if (!(clk & CLK_INT_EN)) {
+		wr16(hc, SDHCI_CLOCK_CONTROL, (uint16_t)(clk | CLK_INT_EN));
+		for (int i = 0; i < 2000 && !(rd16(hc, SDHCI_CLOCK_CONTROL) & CLK_INT_STABLE); i++) {
+			delay(10);
+		}
+		clk = rd16(hc, SDHCI_CLOCK_CONTROL);
+	}
+	if (!(clk & CLK_SD_EN)) {
+		wr16(hc, SDHCI_CLOCK_CONTROL, (uint16_t)(clk | CLK_SD_EN));
+	}
+	/* Polled: latch every status bit, raise no interrupt */
+	wr32(hc, SDHCI_SIGNAL_ENABLE, 0);
+	wr32(hc, SDHCI_INT_ENABLE, 0xffffffff);
+	dump_regs("SDHCI mode on");
+
+	int error = mmc_wake();
+	if (error) {
+		printf("gtel mmc: resuming lk2nd's session failed (%d), re-identifying the card\n", error);
+		sdhci_reset_lines();
+		error = mmc_identify();
+	}
+	if (error) {
+		printf("gtel mmc: card not in transfer state (%d), giving up\n", error);
+		return;
+	}
+	mmc_print_gpt();
+}
+
+void gtel_mmc_probe(void);
+
+void
+gtel_mmc_probe(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("gtelmmc", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(gtel_mmc_probe_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
