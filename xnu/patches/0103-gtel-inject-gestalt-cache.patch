+
+/*
+ * libMobileGestalt's cache loader only ever opens the systemgroup container
+ * copy of the cache; /var/mobile/Library/Caches is only a legacy check.
+ * containermanagerd never ran on this rootfs, so create the path ourselves.
+ */
+static const char *const sweet_gestalt_dirs[] = {
+	"/private/var/containers",
+	"/private/var/containers/Shared",
+	"/private/var/containers/Shared/SystemGroup",
+	"/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache",
+	"/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache/Library",
+	"/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache/Library/Caches",
+};
+
+static void
+sweet_inject_gestalt_cache(void)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	const char *path = "/private/var/containers/Shared/SystemGroup/"
+	    "systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist";
+
+	mount_t mp = rootvnode ? rootvnode->v_mount : NULL;
+	uint64_t saved_flags = 0;
+	if (mp && (mp->mnt_flag & MNT_RDONLY)) {
+		saved_flags = mp->mnt_flag;
+		mp->mnt_flag &= ~MNT_RDONLY;
+	}
+
+	for (size_t i = 0; i < sizeof(sweet_gestalt_dirs) / sizeof(sweet_gestalt_dirs[0]); i++) {
+		int merr = sweet_kernel_mkdir(sweet_gestalt_dirs[i], 0755);
+		if (merr != 0 && merr != EEXIST) {
+			printf("SWEET: mkdir %s failed (errno %d)\n", sweet_gestalt_dirs[i], merr);
+		}
+	}
+
+	/* Always rewrite: an older, wrongly encoded cache may already be on disk. */
+	printf("SWEET: Writing iPad4,4 MobileGestalt cache to %s (%lu bytes)...\n",
+	    path, (unsigned long)sizeof(sweet_gestalt_plist));
+
+	int error = vnode_open(path, (O_CREAT | FWRITE | O_TRUNC | O_NOFOLLOW), 0644, 0, &vp, ctx);
+	if (error == 0) {
+		int resid = 0;
+		int err = vn_rdwr(UIO_WRITE, vp, (caddr_t)sweet_gestalt_plist,
+		    (int)sizeof(sweet_gestalt_plist), 0, UIO_SYSSPACE,
+		    IO_NODELOCKED | IO_UNIT, vfs_context_ucred(ctx), &resid,
+		    vfs_context_proc(ctx));
+		(void)VNOP_FSYNC(vp, MNT_WAIT, ctx);
+		vnode_close(vp, FWRITE, ctx);
+		if (err == 0) {
+			printf("SWEET: MobileGestalt cache written successfully!\n");
+		} else {
+			printf("SWEET: MobileGestalt cache write failed with errno %d\n", err);
+		}
+	} else {
+		printf("SWEET: Failed to create %s (errno %d)\n", path, error);
+	}
+
+	if (mp && saved_flags) {
+		mp->mnt_flag = saved_flags;
+	}
+}
