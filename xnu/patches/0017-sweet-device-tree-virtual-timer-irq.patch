diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 3ad743f..cc0ee0d 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -169,6 +169,95 @@ pe_init_fiq()
 	__builtin_arm_wsr64("ICC_IGRPEN0_EL1", 1);
 	__builtin_arm_isb(ISB_SY);
 }
+#elif defined(SWEET)
+
+#include <libkern/section_keywords.h>
+
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+
+vm_offset_t gicd_base = 0;
+vm_offset_t gicc_base = 0;
+
+void
+pe_init_fiq(void)
+{
+	int error;
+	DTEntry entry;
+
+	if (!gicd_base) {
+		// Find GIC DT node
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+		kprintf("SWEET GIC-400: virtual timer INTID %u\n", sweet_vtimer_intid);
+
+		// Find "reg" property
+		void const *prop;
+		unsigned int prop_size;
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC MMIO regions in DT", __func__);
+		}
+
+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
+		}
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+
+		uint64_t const gicd_base_prop = ((uint64_t const *) prop)[0];
+		uint64_t const gicd_size_prop = ((uint64_t const *) prop)[1];
+		uint64_t const gicc_base_prop = ((uint64_t const *) prop)[2];
+		uint64_t const gicc_size_prop = ((uint64_t const *) prop)[3];
+
+		// Map GICD and GICC
+		gicd_base = ml_io_map(soc_base_phys + gicd_base_prop, gicd_size_prop);
+		if (!gicd_base) {
+			panic("%s: cannot map GICD region", __func__);
+		}
+
+		gicc_base = ml_io_map(soc_base_phys + gicc_base_prop, gicc_size_prop);
+		if (!gicc_base) {
+			panic("%s: cannot map GICC region", __func__);
+		}
+
+		// Enable distributor (GICD_CTLR = 1: enable)
+		uint32_t gicd_ctlr = *(volatile uint32_t *)(gicd_base + 0x000);
+		gicd_ctlr |= 0x3; // Enable Group 0 and Group 1
+		*(volatile uint32_t *)(gicd_base + 0x000) = gicd_ctlr;
+	}
+
+	// Per-CPU GICD bank initialization for SGIs/PPIs:
+	// Set priorities for interrupts 0..31 to 0xA0
+	for (unsigned int i = 0; i < 32; i += 4) {
+		*(volatile uint32_t *)(gicd_base + 0x400 + i) = 0xA0A0A0A0;
+	}
+	// Enable virtual timer PPI and IPI SGI in GICD_ISENABLER0 (offset 0x100)
+	*(volatile uint32_t *)(gicd_base + 0x100) = (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI);
+
+	// Per-CPU GICC CPU interface initialization:
+	// Set binary point to 0
+	*(volatile uint32_t *)(gicc_base + 0x008) = 0;
+	// Set priority mask to 0xFF (accept all priorities)
+	*(volatile uint32_t *)(gicc_base + 0x004) = 0xFF;
+	// Enable CPU interface (GICC_CTLR = 1)
+	*(volatile uint32_t *)(gicc_base + 0x000) = 0x1;
+	__builtin_arm_isb(ISB_SY);
+}
 #else
 void
 pe_init_fiq()
