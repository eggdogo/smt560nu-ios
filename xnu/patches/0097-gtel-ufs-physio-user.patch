diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index ff9c2f8..5d5b828 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -508,6 +508,13 @@ sweet_ufs_strategy(buf_t bp)
 		goto done;
 	}
 
+	/*
+	 * physio() on the raw device (fsck_hfs reads /dev/rdisk0s1) hands us
+	 * the caller's user address: copy through copyin/copyout, since PAN
+	 * faults a plain memcpy to it.
+	 */
+	bool user = (vm_offset_t)vaddr < VM_MIN_KERNEL_ADDRESS;
+
 	lck_mtx_lock(&sweet_ufs_lock);
 	for (uint32_t done = 0; done < count;) {
 		uint64_t pos = off + done;
@@ -519,15 +526,23 @@ sweet_ufs_strategy(buf_t bp)
 		if (rd) {
 			error = ufs_read_blocks(su.first_block + lba, blocks);
 			if (!error) {
-				memcpy(vaddr + done, (const char *)bounce + skip, want);
+				if (user) {
+					error = copyout((const char *)bounce + skip, (user_addr_t)(uintptr_t)(vaddr + done), want);
+				} else {
+					memcpy(vaddr + done, (const char *)bounce + skip, want);
+				}
 			}
 		} else {
 			/* Partial device blocks at either end: read, merge, write back. */
 			if (skip || (want % UFS_BLOCK)) {
 				error = ufs_read_blocks(su.first_block + lba, blocks);
 			}
-			if (!error) {
+			if (!error && user) {
+				error = copyin((user_addr_t)(uintptr_t)(vaddr + done), (char *)bounce + skip, want);
+			} else if (!error) {
 				memcpy((char *)bounce + skip, vaddr + done, want);
+			}
+			if (!error) {
 				error = ufs_write_blocks(su.first_block + lba, blocks);
 			}
 		}
