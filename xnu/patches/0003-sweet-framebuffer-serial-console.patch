+/*****************************************************************************/
+
+/*
+ * gtel: framebuffer "serial" for Samsung Galaxy Tab E (SM-T560NU) and MSM8916.
+ * kprintf output is drawn onto the boot framebuffer described by the ADT node
+ * "gtel-fbcon" or "sweet-fbcon":
+ *   reg    = <phys size>       absolute physical address
+ *   width, height              pixels (800x1280)
+ *   stride                     bytes per line (2400 for 24bpp)
+ *   depth                      bits per pixel (24 or 32)
+ */
+
+extern unsigned char iso_font[256 * 16];
+
+#define FBCON_SCALE     2
+#define FBCON_FG        0xffffffffu
+#define FBCON_BG        0xff000000u
+
+static volatile void *fbcon_base;
+static uint32_t fbcon_width, fbcon_height, fbcon_stride, fbcon_depth;
+static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
+
+static void
+fbcon_clear_row(uint32_t row)
+{
+	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE; y++) {
+		if (fbcon_depth == 24) {
+			volatile uint8_t *line = (volatile uint8_t *)fbcon_base + y * fbcon_stride;
+			for (uint32_t x = 0; x < fbcon_width; x++) {
+				line[x * 3 + 0] = 0;
+				line[x * 3 + 1] = 0;
+				line[x * 3 + 2] = 0;
+			}
+		} else {
+			volatile uint32_t *line = (volatile uint32_t *)((uintptr_t)fbcon_base + y * fbcon_stride);
+			for (uint32_t x = 0; x < fbcon_width; x++) {
+				line[x] = FBCON_BG;
+			}
+		}
+	}
+}
+
+static void
+fbcon_newline(void)
+{
+	fbcon_col = 0;
+	fbcon_row = (fbcon_row + 1) % fbcon_rows;
+	fbcon_clear_row(fbcon_row);
+	fbcon_clear_row((fbcon_row + 1) % fbcon_rows);
+}
+
+static void
+fbcon_init(void)
+{
+	fbcon_cols = fbcon_width / (8 * FBCON_SCALE);
+	fbcon_rows = fbcon_height / (16 * FBCON_SCALE);
+	fbcon_col = fbcon_row = 0;
+	for (uint32_t r = 0; r < fbcon_rows; r++) {
+		fbcon_clear_row(r);
+	}
+}
+
+static unsigned int
+fbcon_transmit_ready(void)
+{
+	return 1;
+}
+
+static void
+fbcon_transmit_data(uint8_t c)
+{
+	if (c == '\r') {
+		fbcon_col = 0;
+		return;
+	}
+	if (c == '\n') {
+		fbcon_newline();
+		return;
+	}
+	if (fbcon_col >= fbcon_cols) {
+		fbcon_newline();
+	}
+	const unsigned char *glyph = iso_font + c * 16;
+	uint32_t x0 = fbcon_col * 8 * FBCON_SCALE, y0 = fbcon_row * 16 * FBCON_SCALE;
+	for (uint32_t gy = 0; gy < 16; gy++) {
+		for (uint32_t sy = 0; sy < FBCON_SCALE; sy++) {
+			uint32_t cur_y = y0 + gy * FBCON_SCALE + sy;
+			if (fbcon_depth == 24) {
+				volatile uint8_t *line = (volatile uint8_t *)fbcon_base + cur_y * fbcon_stride;
+				for (uint32_t gx = 0; gx < 8; gx++) {
+					uint8_t val = (glyph[gy] & (1u << gx)) ? 0xff : 0x00;
+					for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
+						uint32_t px = x0 + gx * FBCON_SCALE + sx;
+						line[px * 3 + 0] = val;
+						line[px * 3 + 1] = val;
+						line[px * 3 + 2] = val;
+					}
+				}
+			} else {
+				volatile uint32_t *line = (volatile uint32_t *)((uintptr_t)fbcon_base + cur_y * fbcon_stride);
+				for (uint32_t gx = 0; gx < 8; gx++) {
+					uint32_t px = (glyph[gy] & (1u << gx)) ? FBCON_FG : FBCON_BG;
+					for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
+						line[x0 + gx * FBCON_SCALE + sx] = px;
+					}
+				}
+			}
+		}
+	}
+	fbcon_col++;
+}
+
+static unsigned int
+fbcon_receive_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+fbcon_receive_data(void)
+{
+	return 0;
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) gtel_fbcon_serial_functions =
+{
+	.init = fbcon_init,
+	.transmit_ready = fbcon_transmit_ready,
+	.transmit_data = fbcon_transmit_data,
+	.receive_ready = fbcon_receive_ready,
+	.receive_data = fbcon_receive_data,
+	.device = SERIAL_SWEET_FBCON
+};
+
+static void
+fbcon_probe(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	uint32_t const *val;
+	unsigned int size;
+
+	if (SecureDTFindEntry("name", "gtel-fbcon", &entry) != kSuccess &&
+	    SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess) {
+		return;
+	}
+	if (SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		return;
+	}
+	if (SecureDTGetProperty(entry, "width", (void const **)&val, &size) == kSuccess) {
+		fbcon_width = *val;
+	}
+	if (SecureDTGetProperty(entry, "height", (void const **)&val, &size) == kSuccess) {
+		fbcon_height = *val;
+	}
+	if (SecureDTGetProperty(entry, "stride", (void const **)&val, &size) == kSuccess) {
+		fbcon_stride = *val;
+	}
+	fbcon_depth = 32;
+	if (SecureDTGetProperty(entry, "depth", (void const **)&val, &size) == kSuccess) {
+		fbcon_depth = *val;
+	} else if (fbcon_stride == fbcon_width * 3) {
+		fbcon_depth = 24;
+	}
+	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * (fbcon_depth / 8)) {
+		return;
+	}
+	fbcon_base = (volatile void *)ml_io_map_wcomb(reg[0], reg[1]);
+	if (fbcon_base != NULL) {
+		register_serial_functions(&gtel_fbcon_serial_functions);
+	}
+}
+
 #if HIBERNATION
 /**
  * Transitions the serial driver into a mode that can be run in the hibernation
@@ -777,6 +951,8 @@ serial_init(void)
 
 	PE_parse_boot_argn("disable-uart-irq", &disable_uart_irq, sizeof(disable_uart_irq));
 
+	fbcon_probe();
+
 #ifdef PI3_UART
 	if (SecureDTFindEntry("name", "gpio", &entryP) == kSuccess) {
 		SecureDTGetProperty(entryP, "reg", (void const **)&reg_prop, &prop_size);
