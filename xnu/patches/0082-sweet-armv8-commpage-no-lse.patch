--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -272,8 +272,17 @@ _pfz_trylock_and_enqueue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if defined(__ARM_FEATURE_ATOMICS)
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+#else
+1:
+	ldaxr	w10, [x3]
+	cbnz	w10, 2f
+	stxr	w12, w11, [x3]
+	cbnz	w12, 1b
+2:
+#endif
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -322,8 +331,17 @@ _pfz_trylock_and_dequeue:
 	// Try to grab the lock
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if defined(__ARM_FEATURE_ATOMICS)
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+#else
+1:
+	ldaxr	w10, [x2]
+	cbnz	w10, 2f
+	stxr	w12, w11, [x2]
+	cbnz	w12, 1b
+2:
+#endif
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
