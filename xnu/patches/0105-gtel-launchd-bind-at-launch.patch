+	 * SWEET: hand init one environment variable so dyld resolves every
+	 * lazily-bound import at exec time instead of on first call. On this
+	 * platform the lazy stubs of libMobileGestalt branch through
+	 * __la_symbol_ptr slots that still hold their unbound image values, so
+	 * the first MobileGestalt container-path lookup lands on garbage
+	 * (pc/far 0xf7870000) and every daemon that touches MobileGestalt dies.
+	 * Binding at launch never enters a lazy stub.
+	 */
+	{
+		const char *init_env = "DYLD_BIND_AT_LAUNCH=1";
+		size_t init_env_length = strlen(init_env) + 1;
