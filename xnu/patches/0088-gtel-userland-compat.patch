+#else
 			error = copyin(uap->adesc, &px_args, sizeof(px_args));
+#endif
 		} else {
 			struct user32__posix_spawn_args_desc px_args32;
 
@@ -3488,7 +3500,14 @@ posix_spawn(proc_t ap, struct posix_spawn_args *uap, int32_t *retval)
 			 * This is a bit fragile: <rdar://problem/16427422>
 			 */
 
+#if defined(SWEET)
+			/* iOS 12's struct _posix_spawnattr is 0x90 bytes, ours is longer */
+			bzero(&px_sa, px_sa_offset);
+			if ((error = copyin(px_args.attrp, &px_sa,
+			    MIN(px_args.attr_size, MIN(px_sa_offset, (vm_size_t)0x90)))) != 0) {
+#else
 			if ((error = copyin(px_args.attrp, &px_sa, px_sa_offset)) != 0) {
+#endif
 				goto bad;
 			}
 
@@ -4667,6 +4686,9 @@ bad:
 	}
 
 	assert(exec_failure_reason == NULL);
+#if defined(SWEET)
+	printf("SPAWN err=%d\n", error);
+#endif
 	return error;
 }
 
