@@ -3450,7 +3450,19 @@ posix_spawn(proc_t ap, struct posix_spawn_args *uap, int32_t *retval)
 
 	if (uap->adesc != USER_ADDR_NULL) {
 		if (is_64) {
+#if defined(SWEET)
+			/*
+			 * gtel runs the iOS 12.5.7 userland, whose libsystem_kernel
+			 * passes a 0x60-byte descriptor that ends at persona_info.
+			 * Copying sizeof(px_args) reads the caller's stack into
