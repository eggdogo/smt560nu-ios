diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 1cd8467..f2b3ba4 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -879,6 +879,54 @@ sleh_synchronous(arm_context_t *context, uint32_t esr, vm_offset_t far)
  * Uncategorized exceptions are a catch-all for general execution errors.
  * ARM64_TODO: For now, we assume this is for undefined instruction exceptions.
  */
+#if defined(SWEET)
+/*
+ * The iOS 12 userland reads a few system registers that trap from EL0 on
+ * Cortex-A53 under this kernel's configuration. Emulate the reads so the
+ * process continues instead of taking EXC_BAD_INSTRUCTION.
+ */
+static bool
+sweet_emulate_el0_mrs(arm_saved_state_t *state, uint32_t instr)
+{
+	uint64_t pc = get_saved_state_pc(state);
+	unsigned rt = instr & 0x1f;
+	uint64_t val;
+
+	printf("EMU PC:0x%llx INS:0x%08x\n", pc, instr);
+
+	if (pc == 0x1100a6624ULL) {
+		/* libsystem_kernel's TSD read in the shared cache, which lands in x10 */
+		val = __builtin_arm_rsr64("TPIDRRO_EL0");
+		rt = 10;
+	} else {
+		switch (instr & ~0x1fU) {
+		case 0xd53bd060: val = __builtin_arm_rsr64("TPIDRRO_EL0"); break;
+		case 0xd53bd040: val = __builtin_arm_rsr64("TPIDR_EL0"); break;
+		case 0xd5380020: val = __builtin_arm_rsr64("S3_0_C0_C0_1"); break;
+		case 0xd53be040: val = __builtin_arm_rsr64("CNTVCT_EL0"); break;
+		case 0xd53be000: val = __builtin_arm_rsr64("CNTFRQ_EL0"); break;
+		default: return false;
+		}
+	}
+	if (rt != 31) {
+		set_saved_state_reg(state, rt, val);
+	}
+	add_saved_state_pc(state, 4);
+	return true;
+}
+
+/* For the exit log in proc_prepareexit (BSD cannot see arm_saved_state) */
+void sweet_user_fault_regs(uint64_t *pc, uint32_t *esr, uint64_t *far);
+void
+sweet_user_fault_regs(uint64_t *pc, uint32_t *esr, uint64_t *far)
+{
+	arm_saved_state_t *state = get_user_regs(current_thread());
+	*pc = state ? get_saved_state_pc(state) : 0;
+	*esr = state ? (uint32_t)get_saved_state_esr(state) : 0;
+	*far = state ? get_saved_state_far(state) : 0;
+}
+#endif /* SWEET */
+
 static void
 handle_uncategorized(arm_saved_state_t *state)
 {
@@ -889,6 +937,12 @@ handle_uncategorized(arm_saved_state_t *state)
 
 	COPYIN(get_saved_state_pc(state), (char *)&instr, sizeof(instr));
 
+#if defined(SWEET)
+	if (PSR64_IS_USER64(get_saved_state_cpsr(state)) && sweet_emulate_el0_mrs(state, instr)) {
+		return;
+	}
+#endif
+
 #if CONFIG_DTRACE
 
 	if (PSR64_IS_USER64(get_saved_state_cpsr(state))) {
diff --git a/osfmk/kern/task.c b/osfmk/kern/task.c
index 67c5f79..dd11c40 100644
--- a/osfmk/kern/task.c
+++ b/osfmk/kern/task.c
@@ -612,6 +612,15 @@ task_set_platform_binary(
 boolean_t
 task_get_platform_binary(task_t task)
 {
+#if defined(SWEET)
+	/*
+	 * The iOS 12 binaries are not in any trust cache, so nothing is a
+	 * real platform binary; answering "no" keeps launchd's shared-region
+	 * and legacy mach_msg paths on the ones it expects.
+	 */
+	(void)task;
+	return FALSE;
+#endif
 	return (task_ro_flags_get(task) & TFRO_PLATFORM) != 0;
 }
 
