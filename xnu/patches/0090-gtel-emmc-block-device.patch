+/*
+ * gtel: called by the eMMC probe once the card is in transfer state.
+ * Publishes the partition named by boot-arg ufsroot (default "userdata")
+ * as /dev/ufsroot0 and /dev/rufsroot0, read-only. None of sweet's other
+ * hardware (keys, touch, USB) exists here, so unlike sweet_ufs_init this
+ * starts nothing else.
+ */
+int sweet_ufs_attach_mmc(void);
+
+int
+sweet_ufs_attach_mmc(void)
+{
+	char want[64] = "userdata";
+	int error;
+
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	su.mmc = true;
+	su.secsize = DEV_BSIZE;
+	su.writable = false;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_find_partition(want);
+	if (!error) {
+		/* Self test: the first block, as a filesystem would see it */
+		error = ufs_read_blocks(su.first_block, 1);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		printf("SWEET UFS: eMMC partition \"%s\" unavailable (%d)\n", want, error);
+		return error;
+	}
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	printf("SWEET UFS: \"%s\" first bytes %02x %02x %02x %02x %02x %02x %02x %02x, "
+	    "ext4 magic 0x%02x%02x, HFS+ signature %c%c\n", want,
+	    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[0x439], b[0x438],
+	    b[0x400] >= 0x20 && b[0x400] < 0x7f ? b[0x400] : '.', b[0x401] >= 0x20 && b[0x401] < 0x7f ? b[0x401] : '.');
+
+	su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+	su.ready = true;
+	printf("SWEET UFS: \"%s\" on eMMC: first block 0x%llx, %llu MiB, read-only\n",
+	    want, su.first_block, su.nblocks * UFS_BLOCK >> 20);
+	return 0;
+}
