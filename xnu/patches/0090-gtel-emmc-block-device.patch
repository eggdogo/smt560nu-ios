+/* Block layer entry (sweet_ufs.c): count 512-byte sectors into buf */
+int gtel_mmc_read(uint64_t sector, uint32_t count, void *buf);
+
+int
+gtel_mmc_read(uint64_t sector, uint32_t count, void *buf)
+{
+	uint32_t *p = buf;
+	for (uint32_t i = 0; i < count; i++) {
+		int error = mmc_read_block(sector + i, p + i * (MMC_BLOCK / 4));
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
+}
