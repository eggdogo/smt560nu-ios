+static int
+mmc_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = gtel_mmc_read(1, 1, (void *)b);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("SWEET UFS: eMMC has no GPT\n");
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("SWEET UFS: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	if ((error = gtel_mmc_read(entry_lba, (nent * esz + MMC_SECTOR - 1) / MMC_SECTOR, (void *)b))) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		/* Only whole 4 KiB device blocks; drop a ragged tail */
+		if (last < first || first % MMC_PER_BLOCK) {
+			printf("SWEET UFS: \"%s\" (sectors %llu-%llu) is not 4 KiB aligned\n", want, first, last);
+			return ENXIO;
+		}
+		su.first_block = first / MMC_PER_BLOCK;
+		su.nblocks = (last - first + 1) / MMC_PER_BLOCK;
+		return 0;
+	}
+	printf("SWEET UFS: no eMMC partition named \"%s\"\n", want);
+	return ENOENT;
+}
