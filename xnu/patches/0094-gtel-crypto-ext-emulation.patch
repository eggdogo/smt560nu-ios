+	0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
+	0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
+	0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
+	0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
+	0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
+};
+
+static uint8_t aes_inv_sbox[256];
+
+static inline uint8_t
+gf_xtime(uint8_t x)
+{
+	return (uint8_t)((x << 1) ^ ((x & 0x80) ? 0x1b : 0));
+}
+
+static uint8_t
+gf_mul(uint8_t a, uint8_t b)
+{
+	uint8_t r = 0;
+	while (b) {
+		if (b & 1) {
+			r ^= a;
+		}
+		a = gf_xtime(a);
+		b >>= 1;
+	}
+	return r;
+}
+
+/* State byte i is row i % 4, column i / 4 (register byte order) */
+static void
+aes_round(uint8_t s[16], bool inverse)
+{
+	uint8_t t[16];
+	for (int c = 0; c < 4; c++) {
+		for (int r = 0; r < 4; r++) {
+			int from = inverse ? (c - r + 4) % 4 : (c + r) % 4;
+			uint8_t b = s[r + 4 * from];
+			t[r + 4 * c] = inverse ? aes_inv_sbox[b] : aes_sbox[b];
+		}
+	}
+	memcpy(s, t, 16);
+}
+
+static void
+aes_mix(uint8_t s[16], bool inverse)
+{
+	for (int c = 0; c < 4; c++) {
+		uint8_t *col = s + 4 * c, a0 = col[0], a1 = col[1], a2 = col[2], a3 = col[3];
+		if (!inverse) {
+			col[0] = (uint8_t)(gf_mul(a0, 2) ^ gf_mul(a1, 3) ^ a2 ^ a3);
+			col[1] = (uint8_t)(a0 ^ gf_mul(a1, 2) ^ gf_mul(a2, 3) ^ a3);
+			col[2] = (uint8_t)(a0 ^ a1 ^ gf_mul(a2, 2) ^ gf_mul(a3, 3));
+			col[3] = (uint8_t)(gf_mul(a0, 3) ^ a1 ^ a2 ^ gf_mul(a3, 2));
+		} else {
+			col[0] = (uint8_t)(gf_mul(a0, 14) ^ gf_mul(a1, 11) ^ gf_mul(a2, 13) ^ gf_mul(a3, 9));
+			col[1] = (uint8_t)(gf_mul(a0, 9) ^ gf_mul(a1, 14) ^ gf_mul(a2, 11) ^ gf_mul(a3, 13));
+			col[2] = (uint8_t)(gf_mul(a0, 13) ^ gf_mul(a1, 9) ^ gf_mul(a2, 14) ^ gf_mul(a3, 11));
+			col[3] = (uint8_t)(gf_mul(a0, 11) ^ gf_mul(a1, 13) ^ gf_mul(a2, 9) ^ gf_mul(a3, 14));
+		}
+	}
+}
+
+static inline uint32_t ror32(uint32_t x, unsigned n) { return (x >> n) | (x << (32 - n)); }
+static inline uint32_t rol32(uint32_t x, unsigned n) { return (x << n) | (x >> (32 - n)); }
+static inline uint32_t sha_choose(uint32_t x, uint32_t y, uint32_t z) { return ((y ^ z) & x) ^ z; }
+static inline uint32_t sha_majority(uint32_t x, uint32_t y, uint32_t z) { return (x & y) | ((x | y) & z); }
+static inline uint32_t sha_parity(uint32_t x, uint32_t y, uint32_t z) { return x ^ y ^ z; }
+
+static void
+sha256_hash(uint32_t X[4], uint32_t Y[4], const uint32_t W[4])
+{
+	for (int e = 0; e < 4; e++) {
+		uint32_t chs = sha_choose(Y[0], Y[1], Y[2]);
+		uint32_t maj = sha_majority(X[0], X[1], X[2]);
+		uint32_t t = Y[3] + (ror32(Y[0], 6) ^ ror32(Y[0], 11) ^ ror32(Y[0], 25)) + chs + W[e];
+		X[3] = t + X[3];
+		Y[3] = t + (ror32(X[0], 2) ^ ror32(X[0], 13) ^ ror32(X[0], 22)) + maj;
+		/* <Y:X> = ROL(Y:X, 32) */
+		uint32_t y3 = Y[3], x3 = X[3];
+		X[3] = X[2]; X[2] = X[1]; X[1] = X[0]; X[0] = y3;
+		Y[3] = Y[2]; Y[2] = Y[1]; Y[1] = Y[0]; Y[0] = x3;
+	}
+}
+
+/* Returns true if instr was a Crypto Extension instruction, now emulated */
+static bool
+sweet_emulate_crypto(uint32_t instr)
+{
+	static bool inited;
+	static uint32_t seen;
+	unsigned d = instr & 0x1f, n = (instr >> 5) & 0x1f, m = (instr >> 16) & 0x1f;
+	uint32_t kind;
+
+	if ((instr & 0xffffcc00) == 0x4e284800) {
+		kind = 0;                                       /* AESE/AESD/AESMC/AESIMC */
+	} else if ((instr & 0xffe08c00) == 0x5e000000 && ((instr >> 12) & 7) != 7) {
+		kind = 1;                                       /* SHA1C/P/M/SU0, SHA256H/H2/SU1 */
+	} else if ((instr & 0xffffcc00) == 0x5e280800 && ((instr >> 12) & 0x1f) <= 2) {
+		kind = 2;                                       /* SHA1H, SHA1SU1, SHA256SU0 */
+	} else if ((instr & 0xbfe0fc00) == 0x0ee0e000) {
+		kind = 3;                                       /* PMULL/PMULL2 .1Q */
+	} else {
+		return false;
+	}
+
+	arm_neon_saved_state_t *ns = get_user_neon_regs(current_thread());
+	if (ns == NULL) {
+		return false;
+	}
+	arm_neon_saved_state64_t *v = neon_state64(ns);
+	if (!inited) {
+		for (int i = 0; i < 256; i++) {
+			aes_inv_sbox[aes_sbox[i]] = (uint8_t)i;
+		}
+		inited = true;
+	}
+	if (!(seen & (1u << kind))) {
+		seen |= 1u << kind;
+		printf("SWEET crypto emu: first %s instruction 0x%08x\n",
+		    (const char *[]){ "AES", "SHA (3-reg)", "SHA (2-reg)", "PMULL" }[kind], instr);
+	}
+
+	uint32_t Vd[4], Vn[4], Vm[4], R[4];
+	memcpy(Vd, &v->v.q[d], 16);
+	memcpy(Vn, &v->v.q[n], 16);
+	memcpy(Vm, &v->v.q[m], 16);
+
+	switch (kind) {
+	case 0: {
+		unsigned op = (instr >> 12) & 3;                /* 0 AESE, 1 AESD, 2 AESMC, 3 AESIMC */
+		uint8_t s[16];
+		if (op < 2) {
+			for (int i = 0; i < 4; i++) {
+				R[i] = Vd[i] ^ Vn[i];
+			}
+			memcpy(s, R, 16);
+			aes_round(s, op == 1);
+		} else {
+			memcpy(s, Vn, 16);
+			aes_mix(s, op == 3);
+		}
+		memcpy(R, s, 16);
+		break;
+	}
+	case 1: {
+		unsigned op = (instr >> 12) & 7;
+		if (op <= 2) {                                  /* SHA1C, SHA1P, SHA1M */
+			uint32_t X[4] = { Vd[0], Vd[1], Vd[2], Vd[3] }, Y = Vn[0];
+			for (int e = 0; e < 4; e++) {
+				uint32_t t = op == 0 ? sha_choose(X[1], X[2], X[3]) :
+				    op == 1 ? sha_parity(X[1], X[2], X[3]) : sha_majority(X[1], X[2], X[3]);
+				Y = Y + rol32(X[0], 5) + t + Vm[e];
+				X[1] = rol32(X[1], 30);
+				uint32_t x3 = X[3];
+				X[3] = X[2]; X[2] = X[1]; X[1] = X[0]; X[0] = Y;
+				Y = x3;
+			}
+			memcpy(R, X, 16);
+		} else if (op == 3) {                           /* SHA1SU0 */
+			uint32_t T[4] = { Vd[2], Vd[3], Vn[0], Vn[1] };
+			for (int e = 0; e < 4; e++) {
+				R[e] = T[e] ^ Vd[e] ^ Vm[e];
+			}
+		} else if (op == 4 || op == 5) {                /* SHA256H, SHA256H2 */
+			uint32_t X[4], Y[4];
+			memcpy(X, op == 4 ? Vd : Vn, 16);
+			memcpy(Y, op == 4 ? Vn : Vd, 16);
+			sha256_hash(X, Y, Vm);
+			memcpy(R, op == 4 ? X : Y, 16);
+		} else {                                        /* SHA256SU1 */
+			uint32_t T0[4] = { Vn[1], Vn[2], Vn[3], Vm[0] };
+			for (int e = 0; e < 2; e++) {
+				uint32_t x = Vm[2 + e];
+				R[e] = (ror32(x, 17) ^ ror32(x, 19) ^ (x >> 10)) + Vd[e] + T0[e];
+			}
+			for (int e = 2; e < 4; e++) {
+				uint32_t x = R[e - 2];
+				R[e] = (ror32(x, 17) ^ ror32(x, 19) ^ (x >> 10)) + Vd[e] + T0[e];
+			}
+		}
+		break;
+	}
+	case 2: {
+		unsigned op = (instr >> 12) & 0x1f;
+		if (op == 0) {                                  /* SHA1H */
+			R[0] = rol32(Vn[0], 30);
+			R[1] = R[2] = R[3] = 0;
+		} else if (op == 1) {                           /* SHA1SU1 */
+			uint32_t T[4] = { Vd[0] ^ Vn[1], Vd[1] ^ Vn[2], Vd[2] ^ Vn[3], Vd[3] };
+			R[0] = rol32(T[0], 1);
+			R[1] = rol32(T[1], 1);
+			R[2] = rol32(T[2], 1);
+			R[3] = rol32(T[3], 1) ^ rol32(T[0], 2);
+		} else {                                        /* SHA256SU0 */
+			uint32_t T[4] = { Vd[1], Vd[2], Vd[3], Vn[0] };
+			for (int e = 0; e < 4; e++) {
+				R[e] = (ror32(T[e], 7) ^ ror32(T[e], 18) ^ (T[e] >> 3)) + Vd[e];
+			}
+		}
+		break;
+	}
+	default: {                                          /* PMULL{2} Vd.1Q, Vn.1D, Vm.1D */
+		unsigned hi = (instr >> 30) & 1;
+		uint64_t a, b, lo = 0, hiw = 0;
+		memcpy(&a, (const uint8_t *)Vn + 8 * hi, 8);
+		memcpy(&b, (const uint8_t *)Vm + 8 * hi, 8);
+		for (int i = 0; i < 64; i++) {
+			if ((b >> i) & 1) {
+				lo ^= a << i;
+				hiw ^= i ? a >> (64 - i) : 0;
+			}
+		}
+		memcpy(R, &lo, 8);
+		memcpy((uint8_t *)R + 8, &hiw, 8);
+		break;
+	}
+	}
+	memcpy(&v->v.q[d], R, 16);
+	return true;
+}
