+/*
+ * gtel: ARMv8 Crypto Extension emulation for EL0.
+ *
+ * MSM8916's Cortex-A53 cores are built without the Crypto Extension, but
+ * every Apple arm64 CPU has it, so iOS (corecrypto in the shared cache)
+ * issues AES/SHA/PMULL instructions without a feature check and takes
+ * SIGILL. They trap here as uncategorized exceptions: compute the result
+ * on the thread's saved vector registers (Arm ARM pseudocode) and step
+ * over the instruction. Slow, but exact, and it covers every binary.
+ */
+static const uint8_t aes_sbox[256] = {
